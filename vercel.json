{
  "version": 2,
  "name": "presentacion-automatica",
  "builds": [
    {
      "src": "presentacion-completa.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/presentacion-completa.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
